{
  "name": "@remit/world-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agentbook": {
      "types": "./dist/agentbook.d.ts",
      "import": "./dist/agentbook.js"
    },
    "./ens": {
      "types": "./dist/ens.d.ts",
      "import": "./dist/ens.js"
    },
    "./human-approval": {
      "types": "./dist/human-approval.d.ts",
      "import": "./dist/human-approval.js"
    },
    "./privacy": {
      "types": "./dist/privacy.d.ts",
      "import": "./dist/privacy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@remit/domain": "workspace:*",
    "@remit/protocol": "workspace:*",
    "@worldcoin/agentkit": "0.2.0",
    "@worldcoin/idkit-core": "4.2.2",
    "viem": "2.55.8"
  }
}
