{
  "name": "invoiceguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && rm -rf .turbo coverage",
    "demo": "tsx scripts/demo.ts",
    "dev": "turbo run dev --parallel",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "gate:agentbook": "tsx scripts/verify-humans.ts",
    "gate:zerog": "tsx scripts/gate-zerog-live.ts",
    "lint": "eslint . --max-warnings 0",
    "migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:persistence": "vitest run --config vitest.persistence.config.ts",
    "typecheck": "pnpm typecheck:workspaces && pnpm typecheck:tests && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:workspaces": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@hiero-ledger/sdk": "2.85.0",
    "@invoiceguard/domain": "workspace:*",
    "@invoiceguard/persistence": "workspace:*",
    "@invoiceguard/protocol": "workspace:*",
    "@invoiceguard/zerog-adapter": "workspace:*",
    "@types/node": "catalog:",
    "@worldcoin/agentkit": "0.2.0",
    "@x402/core": "2.19.0",
    "@x402/hedera": "2.19.0",
    "eslint": "catalog:",
    "fast-check": "4.9.0",
    "postgres": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
