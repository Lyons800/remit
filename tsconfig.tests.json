{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "noEmit": true,
    // The Hedera SDK declarations do not compile cleanly under node16
    // resolution. Test source remains fully checked.
    "skipLibCheck": true
  },
  "include": [
    "apps/**/*.test.ts",
    "packages/**/*.test.ts",
    "services/**/*.test.ts",
    "tests/**/*.ts"
  ]
}
