{
  "name": "@remit/settlement-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "node --conditions=development --env-file=../../.env.example --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@remit/runtime-config": "workspace:*",
    "@hono/node-server": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
